<Project Sdk="Godot.NET.Sdk/4.5.0">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>SnowfallenMod</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SnowfallenCode/**/*.cs" />
    <Compile Include="Snowfallen/MainFile.cs" />
    <AdditionalFiles Include="Snowfallen/localization/**/*.json" />
    <Reference Include="0Harmony"><HintPath>$(GameDataDir)/0Harmony.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameDataDir)/GodotSharp.dll</HintPath></Reference>
    <Reference Include="sts2"><HintPath>$(GameDataDir)/sts2.dll</HintPath></Reference>
    <Reference Include="BaseLib"><HintPath>$(BaseLibDll)</HintPath></Reference>
    <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="0.1.6" />
  </ItemGroup>
  <Target Name="CheckLocalDependencies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDataDir)' == ''" Text="Set GameDataDir to the matching game's data_sts2_windows_x86_64 directory." />
    <Error Condition="!Exists('$(GameDataDir)/sts2.dll')" Text="sts2.dll missing; check GameDataDir and game version." />
    <Error Condition="!Exists('$(GameDataDir)/GodotSharp.dll')" Text="GodotSharp.dll missing in GameDataDir." />
    <Error Condition="!Exists('$(GameDataDir)/0Harmony.dll')" Text="0Harmony.dll missing in GameDataDir." />
    <Error Condition="'$(BaseLibDll)' == '' Or !Exists('$(BaseLibDll)')" Text="Set BaseLibDll to the matching BaseLib.dll file." />
  </Target>
</Project>
