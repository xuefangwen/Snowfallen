{
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.0-attack": "None",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.ancient": "再次复苏吧……",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.next": "继续",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.char": "你依旧保留这份禁忌的力量",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.next": "继续",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.ancient": "建筑师……杀死他……",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.next": "继续",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.0-3r.char": "我不会将其用于杀戮，即使再度轮回",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.0-3r.next": "继续",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.0-4r.ancient": "无所谓，接受我的力量，它会为你扫清建筑师前的障碍……",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.0-4r.next": "继续",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.ancient": "总该相信了吧，建筑师从不是什么好人……",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.next": "继续",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.char": "我自会明晰",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.next": "继续",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.ancient": "你会再一次在塔底见到我……",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.next": "继续",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.1-3r.char": "……",
  "NEOW.talk.SNOWFALLENMOD-SNOWFALLEN.1-3r.next": "继续",
  "DARV.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.ancient": "你是医生？哦，我见过你的同族，都是很厉害的医生！",
  "DARV.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.next": "继续",
  "DARV.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.char": "略懂",
  "DARV.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.next": "继续",
  "DARV.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.ancient": "随便挑上一件吧！我的财宝任何一件都可以作为预付给你的出诊费！",
  "DARV.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.next": "继续",
  "DARV.talk.SNOWFALLENMOD-SNOWFALLEN.0-3r.char": "我仅将它用于寻找建筑师的道路上",
  "DARV.talk.SNOWFALLENMOD-SNOWFALLEN.0-3r.next": "继续",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.ancient": "多么美丽的皮毛，应当配上最华丽的配饰。",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.next": "继续",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.char": "承蒙关照。",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.next": "继续",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.ancient": "收下我的赐福，它是世上最无可替代的宝物。",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.next": "继续",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.char": "（内心暗想）也不知道值不值钱……",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.next": "继续",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.ancient": "你居然想把我的赐福换成碎片分发给那些无能的人！？",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.next": "继续",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.1-3r.ancient": "我承认你是不一样的了。",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.1-3r.next": "继续",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.1-4r.char": "（尴尬地咳了两声）",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.1-4r.next": "继续",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.2-0r.ancient": "建筑师疯了，你是医生正好治治他。",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.2-0r.next": "继续",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.2-1r.char": "他也受到荒疫影响了吗？",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.2-1r.next": "继续",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.2-2r.ancient": "带上我的“敲门砖”，去见他吧。",
  "NONUPEIPE.talk.SNOWFALLENMOD-SNOWFALLEN.2-2r.next": "继续",
  "OROBAS.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.ancient": "大狐狸！撸撸毛！撸撸毛！！",
  "OROBAS.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.next": "继续",
  "OROBAS.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.char": "（被热情的抱抱裹得不知所措）",
  "OROBAS.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.next": "继续",
  "OROBAS.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.ancient": "带上它！下次再来！！",
  "OROBAS.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.next": "继续",
  "OROBAS.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.ancient": "你是医生！水的味道！！",
  "OROBAS.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.next": "继续",
  "OROBAS.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.char": "我此行正是要去向建筑师询问荒疫的根治法子",
  "OROBAS.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.next": "继续",
  "OROBAS.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.ancient": "荒疫……？建筑师是好人！和他聊聊！他需要医生！",
  "OROBAS.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.next": "继续",
  "PAEL.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.ancient": "你居然不以杀死父亲作为目标……",
  "PAEL.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.next": "继续",
  "PAEL.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.char": "我只为寻求一个方法",
  "PAEL.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.next": "继续",
  "PAEL.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.ancient": "带上我的一部分吧，它会带着你找到父亲。",
  "PAEL.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.next": "继续",
  "PAEL.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.ancient": "你在寻找父亲？",
  "PAEL.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.next": "继续",
  "PAEL.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.char": "哦，原来建筑师是龙？",
  "PAEL.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.next": "继续",
  "PAEL.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.ancient": "……（佩尔不再言语，把身体的一部分分离出来）",
  "PAEL.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.next": "继续",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.ancient": "来战斗吧！你有一把好武器！",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.next": "继续",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.char": "抱歉，时间紧迫……",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.next": "继续",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.char": "（被突如其来的攻击打断）",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.next": "继续",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.0-3r.char": "（一段时间后）",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.0-3r.next": "继续",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.0-4r.ancient": "酣畅淋漓的战斗！选择一件吧，我的武器不弱于你的武器！",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.0-4r.next": "继续",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.0-5r.char": "我先缓缓……",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.0-5r.next": "继续",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.ancient": "强大的战士！为什么没有血气！",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.next": "继续",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.char": "我为什么要杀人？",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.next": "继续",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.ancient": "战士就应当永无止境地战斗！",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.next": "继续",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.1-3r.ancient": "等你回来，我们继续战斗！！！",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.1-3r.next": "继续",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.1-4r.char": "我得先做更要紧的事情……",
  "TANX.talk.SNOWFALLENMOD-SNOWFALLEN.1-4r.next": "继续",
  "TEZCATARA.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.ancient": "噢亲爱的，你不觉得你那红色的皮毛少了些光泽吗？",
  "TEZCATARA.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.next": "继续",
  "TEZCATARA.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.char": "也许是舟车劳顿太累了吧",
  "TEZCATARA.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.next": "继续",
  "TEZCATARA.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.ancient": "喝下这碗汤暖暖身子吧，然后用鲜血的颜色装点你的毛发！",
  "TEZCATARA.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.next": "继续",
  "TEZCATARA.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.ancient": "建筑师害了很多人，你该杀死他！",
  "TEZCATARA.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.next": "继续",
  "TEZCATARA.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.char": "等我见到他，一切都会明了的。",
  "TEZCATARA.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.next": "继续",
  "TEZCATARA.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.ancient": "你一定饿了吧？在见到他之前先填饱肚子吧。",
  "TEZCATARA.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.next": "继续",
  "TEZCATARA.talk.SNOWFALLENMOD-SNOWFALLEN.1-3r.char": "感激不尽……",
  "TEZCATARA.talk.SNOWFALLENMOD-SNOWFALLEN.1-3r.next": "继续",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.ancient": "哦？你会关心那些蝼蚁？",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.next": "继续",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.char": "与你何干。",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.next": "继续",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.ancient": "我知道，我有更好的方法让你保护他们……",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.next": "继续",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.0-3r.char": "从一个恶魔手里寻求救世的方法？",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.0-3r.next": "继续",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.0-4r.char": "我顶多只会向你寻求一点战斗上的帮助，仅此而已。",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.0-4r.next": "继续",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.char": "好标准的恶魔形象。",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.next": "继续",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.ancient": "你的坚持，你的迷茫，你的戒备，我都知道……",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.next": "继续",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.char": "不签，合同弯弯绕绕的最复杂了。",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.next": "继续",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.1-3r.ancient": "你会品尝到契约的好处的……",
  "VAKUU.talk.SNOWFALLENMOD-SNOWFALLEN.1-3r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.char": "终于……见到你了。",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.0-0r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.ancient": "哪里来的小狐狸？……寻求治疗荒疫的方法？",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.0-1r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.ancient": "你先治治你的圣母心吧！",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.0-2r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.ancient": "锲而不舍，和其他几个东西一样烦人。",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.1-0r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.char": "你也病了，荒疫把你影响得不轻。",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.1-1r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.ancient": "我！？我感到前所未有的好！",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.1-2r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.1-3r.ancient": "我会把那些病灶挨个清理，然后这个世界会更美好！",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.1-3r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.1-4r.char": "这就是，你的答案……",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.1-4r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.2-0r.ancient": "你已经爬上来多少次了？不为杀戮，不为复仇，我有些敬佩你了。",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.2-0r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.2-1r.char": "一次次轮回的滋味确实不好受，但是在荒疫依旧肆虐的地方，每个人都会更加痛苦。",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.2-1r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.2-2r.ancient": "我没有现在办法。",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.2-2r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.2-3r.ancient": "回去吧，答案在未来。",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.2-3r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.3-0r.char": "我又来了。",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.3-0r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.3-1r.ancient": "我是建筑师，不是医生。",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.3-1r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.3-2r.char": "还是时候未到？",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.3-2r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.3-3r.ancient": "或许你会在哪一次在塔中寻找到我未曾注意的方法。你是个偏执的医生。",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.3-3r.next": "继续",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.3-4r.char": "……",
  "THE_ARCHITECT.talk.SNOWFALLENMOD-SNOWFALLEN.3-4r.next": "继续"
}
